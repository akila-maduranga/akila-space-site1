# ─────────────────────────────────────────────────────────────
#  Cosmosfolio — environment variables
#  Copy to .env.local for development, or add them in
#  Vercel → Project → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────

# Supabase → Dashboard → Settings → API
# Without these the site runs in demo mode (localStorage).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only — NEVER expose this to the browser.
# Used by /api/admin/* routes to write content & read analytics.
SUPABASE_SERVICE_ROLE_KEY=

# Admin dashboard password (default: admin123 — change it!)
ADMIN_PASSWORD=
