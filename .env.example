# ─────────────────────────────────────────────────────────────
#  Cosmosfolio — environment variables
#  Copy to .env.local for development, or add them in
#  Vercel → Project → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────

# Supabase → Dashboard → Settings → API
# Without these the site runs in demo mode (localStorage).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only — NEVER expose this to the browser.
# Used by /api/admin/* routes to write content & read analytics.
SUPABASE_SERVICE_ROLE_KEY=

# Admin dashboard password (default: admin123 — change it!)
ADMIN_PASSWORD=

# ── Email (Resend) — contact form + inbox forwarding ─────────
# Get a free key at resend.com (free plan: 100 mails/day).
# Without RESEND_API_KEY the contact form falls back to mailto:.
RESEND_API_KEY=

# Contact form (/api/contact) — where visitor messages come from / go to.
# CONTACT_FROM_EMAIL=Portfolio Contact <contact@akila.space>
# CONTACT_TO_EMAIL=your-private-inbox@gmail.com

# Inbound forwarding (/api/email-forward webhook) — receives mail sent to
# any address @your-domain (MX record in Resend) and forwards it to you.
# CONTACT_FORWARD_TO=your-private-inbox@gmail.com
# CONTACT_DOMAIN=akila.space
